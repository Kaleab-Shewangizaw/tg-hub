# Copy to .env.local. Everything here is server-side only.

# Public base URL of the web app (https in production; used for webhooks).
APP_URL=http://localhost:3000

# Where the SQLite database lives (default: apps/web/data).
# DATA_DIR=./data

# ── Telegram (leave empty to run in development/simulated mode) ──
# From @BotFather → /newbot.
TELEGRAM_BOT_TOKEN=
# The bot's username without @, e.g. emberly_bot (optional; looked up via getMe if empty).
TELEGRAM_BOT_USERNAME=
# Random string (A-Z a-z 0-9 _ -, up to 256 chars). Telegram echoes it in
# X-Telegram-Bot-Api-Secret-Token so we can reject forged webhook calls.
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for the reminder cron endpoint (Authorization: Bearer ...).
CRON_SECRET=

# Comma-separated emails that always have admin access to /admin.
# You can also promote an account with: pnpm --filter web admin:grant you@example.com
ADMIN_EMAILS=

# The server runs a background worker (reminders every 5 minutes, and Telegram
# polling when Admin → Bot is set to polling). Set to "off" if you run several
# instances or prefer an external cron calling /api/cron/reminders.
# TALLY_BACKGROUND=off
